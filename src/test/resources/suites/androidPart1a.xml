<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Android Suite (Part 1A: Foundational + Settings + Profile)" verbose="1">
    <listeners>
        <listener class-name="core.RetryListener"/>
    </listeners>
    <test name="Android part 1A">
        <classes>
            <class name="tests.SmokeTest"/>                 <!-- запуск приложения 1 кейс -->
            <class name="tests.LanguageSelectionTest"/>     <!-- выбор языка (2 опции) 6 кейсов -->
            <class name="tests.MainScreenTest"/>            <!-- главный экран 4 кейса -->
            <class name="tests.SettingsTest"/>              <!-- экран настроек 12 кейсов -->
            <class name="tests.ProfileTest"/>               <!-- экран "Профиль" 7 кейсов -->
            <class name="tests.KazakhLocalizationTest"/>    <!-- казахская локализация 4 кейса -->
        </classes>
    </test>
</suite>
